        "description": "Read-only observation. It does not dispatch, resume, reconcile, or modify a Mission.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,80}$"
            },
            "description": "Optional correlation ID; returned as a response header."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
