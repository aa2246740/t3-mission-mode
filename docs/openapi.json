  "components": {
    "schemas": {
      "MissionSnapshot": {
        "type": "object",
        "required": ["state", "features", "modelSettings", "progressLog"],
        "properties": {
          "state": {
            "type": "object",
            "properties": {
              "initialized": {
                "type": "boolean"
              },
              "missionId": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "revision": {
                "type": "integer"
              }
            },
            "additionalProperties": true
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "modelSettings": {
            "type": "object",
            "additionalProperties": true
          },
          "progressLog": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "code": {
            "type": "string"
          },
