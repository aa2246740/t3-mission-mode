# Paths are local; the app does not load this file automatically.
T3_MISSION_SKILL_ROOT=/absolute/path/to/t3-mission-mode
T3_MISSION_PROJECT_ROOT=/absolute/path/to/your-project
# Keep the optional execution backend disabled for observational HUD use.
T3_MISSION_LOCAL_WORKER_DAEMON=0
# Optional command notification URL. Treat URLs containing credentials as secrets.
# T3_MISSION_NOTIFY_URL=https://your-approved-notification-endpoint.invalid/
# The T3 host provides T3_ACP_MCP_NODE for real provider dispatch. Standalone QA
# uses no transport and no credentials, and never starts a provider task.
